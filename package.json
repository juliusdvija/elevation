{
  "name": "elevation",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "fuzz": "vitest run --config scripts/vitest.config.ts --silent=false scripts/fuzz.test.ts scripts/fuzz-ops.test.ts",
    "import-check": "vitest run --config scripts/vitest.config.ts --silent=false scripts/obj.test.ts",
    "bench": "vitest run --config scripts/vitest.config.ts --silent=false scripts/bench.test.ts"
  },
  "dependencies": {
    "lucide": "^1.55.0",
    "three": "^0.186.1",
    "three-gpu-pathtracer": "^0.0.27",
    "three-mesh-bvh": "^0.9.16"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
